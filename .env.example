# These variables must be exported into the backend process; no secrets are bundled in the client.
# Optional default model. Without an API key, manual authoring and practice still work.
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-flash
AI_API_KEY=
# Optional: comma-separated HTTPS provider hosts allowed for outbound model requests.
# AI_ALLOWED_HOSTS=api.deepseek.com,api.openai.com
# DATABASE=/absolute/path/to/examhub.sqlite3
PORT=5000
# Set true only when deployed behind HTTPS.
SESSION_COOKIE_SECURE=false
